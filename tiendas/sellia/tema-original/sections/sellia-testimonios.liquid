{{ 'sellia-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
    color: {{ section.settings.color_texto }};
  }
  #shopify-section-{{ section.id }} .sellia-eyebrow { color: {{ section.settings.color_acento }}; }
  #shopify-section-{{ section.id }} .sellia-testi__card { border-color: {{ section.settings.color_borde }}; }
  #shopify-section-{{ section.id }} .sellia-testi__stars { color: {{ section.settings.color_acento }}; }
{% endstyle %}

<section class="sellia-section sellia-testi">
  <div class="sellia-container">
    <div class="sellia-container--narrow sellia-center sellia-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sellia-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="sellia-h2">{{ section.settings.titular }}</h2>
      {%- if section.settings.subtitulo != blank -%}
        <p class="sellia-sub">{{ section.settings.subtitulo }}</p>
      {%- endif -%}
    </div>

    <div class="sellia-testi__grid">
      {%- for block in section.blocks -%}
        {%- assign i = forloop.index0 -%}
        <div class="sellia-testi__card sellia-reveal sellia-reveal--stagger" style="--sellia-i: {{ i }};" {{ block.shopify_attributes }}>
          {%- if block.settings.foto != blank -%}
            <div class="sellia-testi__photo">
              <img
                src="{{ block.settings.foto | image_url: width: 200 }}"
                alt="{{ block.settings.foto.alt | default: 'Foto del producto Sellia' | escape }}"
                loading="lazy"
                width="{{ block.settings.foto.width }}"
                height="{{ block.settings.foto.height }}"
              >
            </div>
          {%- endif -%}
          <div class="sellia-testi__stars">
            {%- assign estrellas = block.settings.estrellas | default: 5 -%}
            {%- for s in (1..5) -%}
              {%- if s <= estrellas -%}
                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <p class="sellia-testi__quote">&ldquo;{{ block.settings.texto }}&rdquo;</p>
          <div class="sellia-testi__author">
            {{ block.settings.nombre }}
            {%- if block.settings.detalle != blank -%}
              <span class="sellia-testi__meta">&middot; {{ block.settings.detalle }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sellia – Testimonios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Opiniones" },
    { "type": "text", "id": "titular", "label": "Titular", "default": "Lo que dicen quienes ya lo usan" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo (opcional)" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#221D17" },
    { "type": "color", "id": "color_acento", "label": "Acento (estrellas)", "default": "#E8652B" },
    { "type": "color", "id": "color_borde", "label": "Borde de las tarjetas", "default": "#E4DDCF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "testimonio",
      "name": "Testimonio",
      "settings": [
        { "type": "image_picker", "id": "foto", "label": "Foto del producto (opcional)" },
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "texto", "label": "Reseña", "default": "Lo tengo pegado a la nevera y lo uso a diario. Se acabó pelear con las pinzas del pan de molde." },
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Marta G." },
        { "type": "text", "id": "detalle", "label": "Detalle (opcional)", "default": "Compradora verificada" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sellia – Testimonios",
      "blocks": [ { "type": "testimonio" }, { "type": "testimonio" }, { "type": "testimonio" } ]
    }
  ]
}
{% endschema %}
