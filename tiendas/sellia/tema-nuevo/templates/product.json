    "sellia_resenas": {
      "type": "sellia-resenas",
      "blocks": {
        "t1": {
          "type": "resena",
          "settings": {
            "estrellas": 5,
            "texto": "Lo tengo pegado a la nevera y lo uso casi a diario. Se acabó pelear con las pinzas del pan de molde.",
            "nombre": "Marta G.",
            "iniciales": "MG",
            "detalle": "Compradora verificada"
          }
        },
        "t2": {
          "type": "resena",
          "settings": {
            "estrellas": 5,
            "texto": "Sella al momento, sin esperar a que se caliente nada. Y el corte oculto para abrir la bolsa es un acierto que no esperaba.",
            "nombre": "Javier R.",
            "iniciales": "JR",
            "detalle": "Comprador verificado"
          }
        },
        "t3": {
          "type": "resena",
          "settings": {
            "estrellas": 4,
            "texto": "Muy compacto, cabe en cualquier cajón. Con los 6 niveles de calor lo uso igual para bolsas finas que para las más gruesas del congelador.",
            "nombre": "Lucía P.",
            "iniciales": "LP",
            "detalle": "Compradora verificada"
          }
        }
      },
      "block_order": ["t1", "t2", "t3"],
      "settings": {
        "eyebrow": "Opiniones",
        "titular": "Lo que dicen quienes ya lo usan",
        "mostrar_resumen": true,
        "valoracion_media": 4.7,
        "pie_valoracion": "Opiniones de nuestros primeros clientes",
        "color_fondo": "#FFFFFF"
      }
    },
    "sellia_faq": {
      "type": "aquora-faq",
      "blocks": {
        "q1": { "type": "pregunta", "settings": { "pregunta": "¿Vale para cualquier tipo de bolsa?", "respuesta": "Sí. Tiene 6 niveles de calor para ajustar el sellado desde bolsas finas hasta las más gruesas del congelador." } },
        "q2": { "type": "pregunta", "settings": { "pregunta": "¿Hay que precalentarlo?", "respuesta": "No. Presionas y sella al instante, en 2-3 segundos." } },
        "q3": { "type": "pregunta", "settings": { "pregunta": "¿Dónde lo guardo?", "respuesta": "Tiene una base magnética, así que se queda pegado a la nevera o a cualquier superficie metálica. Y es tan compacto (12 x 5 x 4 cm) que cabe en cualquier cajón." } },
        "q4": { "type": "pregunta", "settings": { "pregunta": "¿Sirve también para abrir la bolsa?", "respuesta": "Sí, tiene un cortador oculto integrado para abrir el paquete cuando lo necesites." } },
        "q5": { "type": "pregunta", "settings": { "pregunta": "¿Se apaga solo?", "respuesta": "Sí, tiene apagado automático." } },
        "q6": { "type": "pregunta", "settings": { "pregunta": "¿Cómo sé qué nivel usar?", "respuesta": "La pantalla LED muestra el nivel elegido: empieza bajo para bolsas finas y sube para las más gruesas." } },
        "q7": { "type": "pregunta", "settings": { "pregunta": "¿Cuánto tarda el envío?", "respuesta": "Entre 7 y 14 días laborables, con seguimiento incluido." } },
        "q8": { "type": "pregunta", "settings": { "pregunta": "¿Y si no me convence?", "respuesta": "Tienes 30 días para devolverlo." } }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5", "q6", "q7", "q8"],
      "settings": {
        "color_fondo": "#FFFFFF",
        "color_texto": "#221D17"
      }
    },
    "sellia_cta_final": {
      "type": "sellia-cta-final",
      "settings": {
        "titular": "Que tu cocina no vuelva a pelear con gomas y pinzas",
        "texto": "Consigue tu Sellia antes de la próxima compra y sella cualquier bolsa en segundos.",
        "color_fondo": "#F7F1E6",
        "color_titulo": "#221D17",
        "padding_top": 80,
        "padding_bottom": 64
      }
    },
    "sellia_confianza_extendida": {
      "type": "sellia-confianza-extendida",
      "blocks": {
        "g1": { "type": "garantia", "settings": { "icono": "shield", "titulo": "Pago 100% seguro", "texto": "Tarjeta, Bizum o PayPal. Tus datos nunca pasan por nuestras manos." } },
        "g2": { "type": "garantia", "settings": { "icono": "truck", "titulo": "Envío en 7-14 días", "texto": "Pedido con seguimiento incluido, para que sepas en todo momento dónde está." } },
        "g3": { "type": "garantia", "settings": { "icono": "return", "titulo": "Garantía de 30 días", "texto": "Si no te convence, te devolvemos el dinero." } },
        "g4": { "type": "garantia", "settings": { "icono": "chat", "titulo": "Trato cercano", "texto": "¿Dudas antes de comprar? Escríbenos y te contesta una persona, no un robot." } }
      },
      "block_order": ["g1", "g2", "g3", "g4"],
      "settings": {
        "eyebrow": "Compra tranquilo",
        "titular": "Compra tranquilo",
        "subtitulo": "Empezamos hace poco, así que cuidamos cada pedido al detalle.",
        "pie": "¿Alguna duda antes de comprar? Escríbenos y te respondemos en menos de 24 horas.",
        "mostrar_insignia": true,
        "insignia_numero": "30",
        "insignia_unidad": "DÍAS",
        "insignia_texto": "Garantía de confianza",
        "color_fondo": "#F2F0EA"
      }
