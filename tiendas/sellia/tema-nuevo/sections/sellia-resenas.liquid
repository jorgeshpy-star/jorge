<style>
  .sr-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  .sr-{{ section.id }} .sr-wrap { max-width: 1080px; margin: 0 auto; }
  .sr-{{ section.id }} .sr-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 40px;
  }
  .sr-{{ section.id }} .sr-eyebrow { display: block; color: {{ section.settings.color_acento }}; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 8px; }
  .sr-{{ section.id }} h2 { font-size: clamp(26px, 3.4vw, 38px); line-height: 1.15; margin: 0; }
  .sr-{{ section.id }} .sr-summary { display: flex; align-items: center; gap: 14px; }
  .sr-{{ section.id }} .sr-summary-number { font-size: 40px; font-weight: 700; line-height: 1; }
  .sr-{{ section.id }} .sr-stars { display: flex; gap: 2px; color: {{ section.settings.color_acento }}; }
  .sr-{{ section.id }} .sr-stars svg { width: 16px; height: 16px; }
  .sr-{{ section.id }} .sr-summary-caption { margin: 4px 0 0; font-size: 13.5px; opacity: 0.65; }
  .sr-{{ section.id }} .sr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .sr-{{ section.id }} .sr-card {
    background: #fff;
    border: 1px solid {{ section.settings.color_borde }};
    border-radius: 16px;
    padding: 26px 24px;
  }
  .sr-{{ section.id }} .sr-card .sr-stars { margin-bottom: 12px; }
  .sr-{{ section.id }} .sr-card .sr-stars svg { width: 15px; height: 15px; }
  .sr-{{ section.id }} .sr-text { font-size: 15px; line-height: 1.6; margin: 0 0 18px; }
  .sr-{{ section.id }} .sr-foot { display: flex; align-items: center; gap: 12px; }
  .sr-{{ section.id }} .sr-avatar {
    width: 38px; height: 38px; border-radius: 50%;
    background: {{ section.settings.color_acento }}1a;
    color: {{ section.settings.color_acento }};
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700; flex-shrink: 0;
  }
  .sr-{{ section.id }} .sr-name { font-size: 14.5px; font-weight: 600; }
  .sr-{{ section.id }} .sr-meta { font-size: 13px; opacity: 0.6; }
</style>

<section class="sr-{{ section.id }}">
  <div class="sr-wrap">
    <div class="sr-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="sr-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.titular != blank -%}<h2>{{ section.settings.titular }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.mostrar_resumen -%}
        {%- assign avg_rounded = section.settings.valoracion_media | round -%}
        <div class="sr-summary">
          <span class="sr-summary-number">{{ section.settings.valoracion_media }}</span>
          <div>
            <div class="sr-stars">
              {%- for i in (1..5) -%}
                {%- if i <= avg_rounded -%}
                  <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if section.settings.pie_valoracion != blank -%}<p class="sr-summary-caption">{{ section.settings.pie_valoracion }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sr-grid">
        {%- for block in section.blocks -%}
          <div class="sr-card" {{ block.shopify_attributes }}>
            <div class="sr-stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.estrellas -%}
                  <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="sr-text">"{{ block.settings.texto }}"</p>
            <div class="sr-foot">
              <span class="sr-avatar">{{ block.settings.iniciales }}</span>
              <div>
                <div class="sr-name">{{ block.settings.nombre }}</div>
                {%- if block.settings.detalle != blank -%}<div class="sr-meta">{{ block.settings.detalle }}</div>{%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sellia – Reseñas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Opiniones" },
    { "type": "text", "id": "titular", "label": "Título", "default": "Lo que dicen quienes ya lo usan" },
    { "type": "header", "content": "Resumen de valoración" },
    { "type": "checkbox", "id": "mostrar_resumen", "label": "Mostrar valoración media", "default": true },
    { "type": "range", "id": "valoracion_media", "label": "Valoración media", "min": 1, "max": 5, "step": 0.1, "default": 4.7 },
    { "type": "text", "id": "pie_valoracion", "label": "Texto bajo las estrellas", "default": "Opiniones de nuestros primeros clientes" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#FFFFFF" },
    { "type": "color", "id": "color_acento", "label": "Acento (estrellas)", "default": "#E8652B" },
    { "type": "color", "id": "color_borde", "label": "Borde de las tarjetas", "default": "#E4DDCF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "texto", "label": "Texto de la reseña", "default": "Muy contenta con la compra." },
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Marta G." },
        { "type": "text", "id": "iniciales", "label": "Iniciales (avatar)", "default": "MG" },
        { "type": "text", "id": "detalle", "label": "Detalle opcional" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sellia – Reseñas",
      "blocks": [ { "type": "resena" }, { "type": "resena" }, { "type": "resena" } ]
    }
  ]
}
{% endschema %}
