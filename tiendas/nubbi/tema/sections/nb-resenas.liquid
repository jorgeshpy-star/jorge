{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="nb-section nb-resenas">
  <div class="nb-container">
    <div class="nb-resenas-head nb-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="nb-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.titular != blank -%}<h2 class="nb-h2">{{ section.settings.titular }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.mostrar_resumen -%}
        <div class="nb-rating-summary">
          <span class="nb-rating-number">{{ section.settings.valoracion_media }}</span>
          <div>
            <div class="nb-stars">
              {%- assign avg_rounded = section.settings.valoracion_media | round -%}
              {%- for i in (1..5) -%}
                {%- if i <= avg_rounded -%}
                  {% render 'nb-icon', icon: 'star' %}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if section.settings.pie_valoracion != blank -%}<p class="nb-body nb-muted nb-rating-caption">{{ section.settings.pie_valoracion }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="nb-grid nb-grid-3 nb-resenas-grid nb-reveal-stagger">
        {%- for block in section.blocks -%}
          <div class="nb-card nb-review-card" {{ block.shopify_attributes }}>
            <div class="nb-stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.estrellas -%}
                  {% render 'nb-icon', icon: 'star' %}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="nb-review-text">"{{ block.settings.texto }}"</p>
            <div class="nb-review-head">
              <span class="nb-review-avatar">{{ block.settings.iniciales }}</span>
              <div>
                <div class="nb-review-name">{{ block.settings.nombre }}</div>
                {%- if block.settings.detalle != blank -%}<div class="nb-review-meta">{{ block.settings.detalle }}</div>{%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Nubbi – Reseñas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Opiniones" },
    { "type": "text", "id": "titular", "label": "Título", "default": "Lo que cuentan las familias que ya viajan con Nubbi" },
    { "type": "header", "content": "Resumen de valoración" },
    { "type": "checkbox", "id": "mostrar_resumen", "label": "Mostrar valoración media", "default": true },
    { "type": "range", "id": "valoracion_media", "label": "Valoración media", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "text", "id": "pie_valoracion", "label": "Texto bajo las estrellas", "default": "Opiniones de nuestros primeros clientes" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#FFFFFF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "texto", "label": "Texto de la reseña", "default": "Muy contenta con la compra." },
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Marta S." },
        { "type": "text", "id": "iniciales", "label": "Iniciales (avatar)", "default": "MS" },
        { "type": "text", "id": "detalle", "label": "Detalle opcional" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nubbi – Reseñas",
      "blocks": [
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "Marta S.", "iniciales": "MS", "detalle": "Mamá de una niña de 3 años", "texto": "Mi hija se queda dormida en cuanto arrancamos y antes se despertaba con el cuello torcido. Con Nubbi ya no pasa. Un acierto total para los viajes largos." } },
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "Carlos R.", "iniciales": "CR", "detalle": "Papá de un niño de 4 años", "texto": "Lo compré para mi hijo y ahora no hay quien se lo quite ni en casa. Se ve blandito pero resistente a la vez." } },
        { "type": "resena", "settings": { "estrellas": 4, "nombre": "Elena M.", "iniciales": "EM", "detalle": "", "texto": "Buena calidad y llegó rápido. Le pondría un punto más si trajera una bolsita para guardarlo, pero muy contenta con la compra." } },
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "Andrea P.", "iniciales": "AP", "detalle": "Mamá de gemelos", "texto": "Compramos dos, uno para cada peque, y un viaje de 6 horas se nos hizo mucho más corto: se durmieron los dos apoyados en su Nubbi." } },
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "David G.", "iniciales": "DG", "detalle": "", "texto": "Se nota que está pensado por alguien que ha hecho viajes largos con niños. Sencillo y hace justo lo que promete." } }
      ]
    }
  ]
}
{% endschema %}
