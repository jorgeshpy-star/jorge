{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .nb-ticker-track {
    color: {{ section.settings.color_texto }};
    animation-duration: {{ section.settings.velocidad }}s;
  }
{% endstyle %}

<section class="nb-section nb-ticker">
  <div class="nb-ticker-viewport">
    <div class="nb-ticker-track">
      {%- for i in (1..2) -%}
        <span class="nb-ticker-item">{{ section.settings.texto }}</span>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nubbi – Ticker",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "texto", "label": "Texto (se repite en bucle)", "default": "🚗 Más de 500 familias ya viajan con Nubbi ✦ Envío 24/48h ✦ Garantía 30 días ✦ Pago 100% seguro ✦" },
    { "type": "range", "id": "velocidad", "label": "Velocidad (segundos por vuelta)", "min": 10, "max": 60, "step": 1, "default": 22 },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#2E2620" },
    { "type": "color", "id": "color_texto", "label": "Color del texto", "default": "#FBF6EE" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 14 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 14 }
  ],
  "presets": [ { "name": "Nubbi – Ticker" } ]
}
{% endschema %}
