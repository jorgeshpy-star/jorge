{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="nb-section nb-infografia">
  <div class="nb-infografia-media nb-reveal">
    {%- if section.settings.imagen != blank -%}
      <div class="nb-ratio nb-infografia-ratio">
        <img
          src="{{ section.settings.imagen | image_url: width: 1400 }}"
          srcset="{{ section.settings.imagen | image_url: width: 700 }} 700w, {{ section.settings.imagen | image_url: width: 900 }} 900w, {{ section.settings.imagen | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 900px) 900px, 100vw"
          alt="{{ section.settings.imagen.alt | escape }}"
          class="nb-img-cover"
          width="{{ section.settings.imagen.width }}"
          height="{{ section.settings.imagen.height }}"
          loading="lazy"
        >
      </div>
    {%- endif -%}
  </div>
  {%- if section.settings.caption != blank -%}
    <p class="nb-body nb-muted nb-infografia-caption">{{ section.settings.caption }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Nubbi – Infografía",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "imagen", "label": "Imagen" },
    { "type": "text", "id": "caption", "label": "Pie de foto (opcional)" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#FFFFFF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Nubbi – Infografía" } ]
}
{% endschema %}
