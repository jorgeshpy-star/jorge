            "testimonio": {
              "type": "text",
              "settings": {
                "text": "<p>\"Mi perra se negaba a beber agua cuando salíamos de paseo y ahora bebe sola en cuanto le acerco el Trotagua. Un acierto total para las rutas largas.\"</p><p><strong>Marta S.</strong> · ★★★★★</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "0.9rem",
