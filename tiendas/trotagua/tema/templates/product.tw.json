    "tw_resenas": {
      "type": "tw-resenas",
      "blocks": {
        "r1": { "type": "resena", "settings": { "estrellas": 5, "nombre": "Marta S.", "iniciales": "MS", "detalle": "Dueña de una golden de 2 años", "texto": "Mi perra se negaba a beber agua cuando salíamos de paseo y ahora bebe sola en cuanto le acerco el Trotagua. Un acierto total para las rutas largas." } },
        "r2": { "type": "resena", "settings": { "estrellas": 5, "nombre": "Carlos R.", "iniciales": "CR", "detalle": "Dueño de un cocker de 4 años", "texto": "Lo compré para las rutas de fin de semana y ahora no salimos sin él. Se ve compacto pero aguanta más agua de la que parece." } },
        "r3": { "type": "resena", "settings": { "estrellas": 4, "nombre": "Elena M.", "iniciales": "EM", "detalle": "", "texto": "Buena calidad y llegó rápido. Le pondría un punto más si trajera un mosquetón, pero muy contenta con la compra." } },
        "r4": { "type": "resena", "settings": { "estrellas": 5, "nombre": "Andrea P.", "iniciales": "AP", "detalle": "Dueña de dos perros", "texto": "Compramos dos, uno para cada perro, y una ruta de 6 horas por el monte se nos hizo mucho más fácil: los dos bebieron sin parar gracias a su Trotagua." } }
      },
      "block_order": ["r1", "r2", "r3", "r4"],
      "settings": {
        "eyebrow": "Opiniones",
        "titular": "Lo que cuentan las familias que ya pasean con Trotagua",
        "mostrar_resumen": true,
        "valoracion_media": 4.8,
        "pie_valoracion": "Opiniones de nuestros primeros clientes",
        "color_fondo": "#FFFFFF"
      }
    },
    "tw_faq": {
      "type": "tw-faq",
      "blocks": {
        "q1": { "type": "pregunta", "settings": { "pregunta": "¿Trotagua sustituye el bebedero fijo de casa?", "respuesta": "No. Trotagua es un bebedero portátil pensado para paseos y viajes; en casa te recomendamos seguir usando su bebedero habitual." } },
        "q2": { "type": "pregunta", "settings": { "pregunta": "¿Solo sirve para el coche?", "respuesta": "Es igual de práctico en el monte, la playa o el día a día: cualquier paseo en el que tu perro pueda tener sed." } },
        "q3": { "type": "pregunta", "settings": { "pregunta": "¿Cómo se limpia?", "respuesta": "Se enjuaga con agua después de cada uso y admite un lavado a fondo con agua y jabón neutro cuando lo necesites." } },
        "q4": { "type": "pregunta", "settings": { "pregunta": "¿Cuánto tarda el envío?", "respuesta": "Entre 24 y 48 horas laborables desde que confirmas tu pedido." } },
        "q5": { "type": "pregunta", "settings": { "pregunta": "¿Y si no queda satisfecho?", "respuesta": "Tienes 30 días desde la recepción para devolverlo si no cumple tus expectativas." } }
      },
      "block_order": ["q1", "q2", "q3", "q4", "q5"],
      "settings": {}
    },
    "tw_cta_final": {
      "type": "tw-cta-final",
      "settings": {
        "titular": "Que ningún paseo se quede sin agua",
        "texto": "Saca tu Trotagua antes del próximo paseo y despreocúpate del agua.",
        "color_fondo": "#F6F5EC",
        "color_titulo": "#242A1F",
        "padding_top": 72,
        "padding_bottom": 56
      }
    },
    "tw_confianza": {
      "type": "tw-confianza",
      "blocks": {
        "c1": { "type": "garantia", "settings": { "icono": "shield", "titulo": "Pago 100% seguro", "texto": "Compra con tarjeta, PayPal o Bizum. Tus datos siempre protegidos." } },
        "c2": { "type": "garantia", "settings": { "icono": "truck", "titulo": "Envío rápido", "texto": "Preparamos y enviamos tu pedido en 24/48 horas laborables." } },
        "c3": { "type": "garantia", "settings": { "icono": "return", "titulo": "30 días para decidir", "texto": "Si no os convence, te devolvemos el importe sin complicaciones." } },
        "c4": { "type": "garantia", "settings": { "icono": "chat", "titulo": "Atención cercana", "texto": "¿Dudas antes de comprar? Escríbenos y te responde una persona, no un robot." } }
      },
      "block_order": ["c1", "c2", "c3", "c4"],
      "settings": {}
    }
