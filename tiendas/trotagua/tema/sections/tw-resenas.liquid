{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="tw-section tw-resenas">
  <div class="tw-container">
    <div class="tw-resenas-head tw-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="tw-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.titular != blank -%}<h2 class="tw-h2">{{ section.settings.titular }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.mostrar_resumen -%}
        <div class="tw-rating-summary">
          <span class="tw-rating-number">{{ section.settings.valoracion_media }}</span>
          <div>
            <div class="tw-stars">
              {%- assign avg_rounded = section.settings.valoracion_media | round -%}
              {%- for i in (1..5) -%}
                {%- if i <= avg_rounded -%}
                  {% render 'tw-icon', icon: 'star' %}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if section.settings.pie_valoracion != blank -%}<p class="tw-body tw-muted tw-rating-caption">{{ section.settings.pie_valoracion }}</p>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="tw-grid tw-grid-3 tw-resenas-grid tw-reveal-stagger">
        {%- for block in section.blocks -%}
          <div class="tw-card tw-review-card" {{ block.shopify_attributes }}>
            <div class="tw-review-top">
              <div class="tw-stars">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.estrellas -%}
                    {% render 'tw-icon', icon: 'star' %}
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6-4.5-4.2 6.1-.7z"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <span class="tw-review-quote" aria-hidden="true">&rdquo;</span>
            </div>
            <p class="tw-review-text">"{{ block.settings.texto }}"</p>
            <div class="tw-review-head">
              <span class="tw-review-avatar">{{ block.settings.iniciales }}</span>
              <div>
                <div class="tw-review-name">{{ block.settings.nombre }}</div>
                {%- if block.settings.detalle != blank -%}<div class="tw-review-meta">{{ block.settings.detalle }}</div>{%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Trotagua – Reseñas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Opiniones" },
    { "type": "text", "id": "titular", "label": "Título", "default": "Lo que cuentan las familias que ya pasean con Trotagua" },
    { "type": "header", "content": "Resumen de valoración" },
    { "type": "checkbox", "id": "mostrar_resumen", "label": "Mostrar valoración media", "default": true },
    { "type": "range", "id": "valoracion_media", "label": "Valoración media", "min": 1, "max": 5, "step": 0.1, "default": 4.8 },
    { "type": "text", "id": "pie_valoracion", "label": "Texto bajo las estrellas", "default": "Opiniones de nuestros primeros clientes" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#FFFFFF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "texto", "label": "Texto de la reseña", "default": "Muy contenta con la compra." },
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "Marta S." },
        { "type": "text", "id": "iniciales", "label": "Iniciales (avatar)", "default": "MS" },
        { "type": "text", "id": "detalle", "label": "Detalle opcional" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trotagua – Reseñas",
      "blocks": [
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "Marta S.", "iniciales": "MS", "detalle": "Dueña de una golden de 2 años", "texto": "Mi perra se negaba a beber agua cuando salíamos de paseo y ahora bebe sola en cuanto le acerco el Trotagua. Un acierto total para las rutas largas." } },
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "Carlos R.", "iniciales": "CR", "detalle": "Dueño de un cocker de 4 años", "texto": "Lo compré para las rutas de fin de semana y ahora no salimos sin él. Se ve compacto pero aguanta más agua de la que parece." } },
        { "type": "resena", "settings": { "estrellas": 4, "nombre": "Elena M.", "iniciales": "EM", "detalle": "", "texto": "Buena calidad y llegó rápido. Le pondría un punto más si trajera un mosquetón, pero muy contenta con la compra." } },
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "Andrea P.", "iniciales": "AP", "detalle": "Dueña de dos perros", "texto": "Compramos dos, uno para cada perro, y una ruta de 6 horas por el monte se nos hizo mucho más fácil: los dos bebieron sin parar gracias a su Trotagua." } },
        { "type": "resena", "settings": { "estrellas": 5, "nombre": "David G.", "iniciales": "DG", "detalle": "", "texto": "Se nota que está pensado por alguien que hace rutas largas con el perro. Sencillo y hace justo lo que promete." } }
      ]
    }
  ]
}
{% endschema %}
