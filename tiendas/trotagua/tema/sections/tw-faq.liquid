{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.color_fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="tw-section tw-faq">
  <div class="tw-container tw-faq-container">
    <div class="tw-faq-head tw-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="tw-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.titular != blank -%}<h2 class="tw-h2">{{ section.settings.titular }}</h2>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="tw-faq-list tw-reveal">
        {%- for block in section.blocks -%}
          <div class="tw-faq-item" data-open="false" {{ block.shopify_attributes }}>
            <button type="button" class="tw-faq-q" aria-expanded="false" aria-controls="tw-faq-a-{{ block.id }}">
              <span>{{ block.settings.pregunta }}</span>
              <span class="tw-faq-icon" aria-hidden="true"></span>
            </button>
            <div class="tw-faq-a" id="tw-faq-a-{{ block.id }}">
              <div class="tw-faq-a-inner">
                <p>{{ block.settings.respuesta }}</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Trotagua – Preguntas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Preguntas frecuentes" },
    { "type": "text", "id": "titular", "label": "Título", "default": "Todo lo que quieras saber antes de comprar" },
    { "type": "header", "content": "Color" },
    { "type": "color", "id": "color_fondo", "label": "Fondo de la sección", "default": "#F6F5EC" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Trotagua sustituye el bebedero fijo de casa?" },
        { "type": "textarea", "id": "respuesta", "label": "Respuesta", "default": "No. Trotagua es un bebedero portátil pensado para paseos y viajes; en casa te recomendamos seguir usando su bebedero habitual." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trotagua – Preguntas",
      "blocks": [
        { "type": "pregunta", "settings": { "pregunta": "¿Trotagua sustituye el bebedero fijo de casa?", "respuesta": "No. Trotagua es un bebedero portátil pensado para paseos y viajes; en casa te recomendamos seguir usando su bebedero habitual." } },
        { "type": "pregunta", "settings": { "pregunta": "¿Solo sirve para el coche?", "respuesta": "Es igual de práctico en el monte, la playa o el día a día: cualquier paseo en el que tu perro pueda tener sed." } },
        { "type": "pregunta", "settings": { "pregunta": "¿Qué tamaños hay disponibles?", "respuesta": "350 ml y 550 ml. Puedes elegir 1 bebedero o el pack de 2 (ahorras 9,95 €) para tener uno de repuesto o para dos perros." } },
        { "type": "pregunta", "settings": { "pregunta": "¿Cómo se limpia?", "respuesta": "Se enjuaga con agua después de cada uso y admite un lavado a fondo con agua y jabón neutro cuando lo necesites." } },
        { "type": "pregunta", "settings": { "pregunta": "¿Cuánto tarda el envío?", "respuesta": "Entre 24 y 48 horas laborables desde que confirmas tu pedido." } },
        { "type": "pregunta", "settings": { "pregunta": "¿Y si no queda satisfecho?", "respuesta": "Tienes 30 días desde la recepción para devolverlo si no cumple tus expectativas." } }
      ]
    }
  ]
}
{% endschema %}
